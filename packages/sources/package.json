{
  "name": "@ledgerline/sources",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Where a declared schema comes from: a migrations directory, a Prisma schema, a live PostgreSQL. And the model file on disk.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --conditions=source --test 'test/**/*.test.ts'",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@ledgerline/model": "workspace:*",
    "@ledgerline/parse": "workspace:*",
    "@mrleebo/prisma-ast": "^0.16.0"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "pg": "^8.23.0",
    "typescript": "^5.9.2"
  }
}
